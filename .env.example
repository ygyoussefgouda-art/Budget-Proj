# Budget me: production settings. Copy to .env on the VPS and fill in:
#   cp .env.example .env && chmod 600 .env && nano .env
# Generate strong random values with:  openssl rand -base64 32

# ---------- database (only used inside Docker) ----------
# REQUIRED, at least 16 characters. The app refuses to start with "change-me".
POSTGRES_PASSWORD=change-me-run-openssl-rand-base64-32
POSTGRES_DB=budget_me
POSTGRES_USER=budget_me

# ---------- accounts ----------
# People create their own accounts on the sign-in screen.
ALLOW_SIGNUP=true
# Strongly recommended on a public server: only people you give this code to can sign up.
# Leave empty to let anyone who can open the site create an account.
SIGNUP_INVITE_CODE=
# Optional built-in account with username "owner" (at least 10 characters). Usually leave empty.
APP_PASSWORD=
# Accounts that can open the Admin page (users, sign-ups, password reset codes), comma separated.
# "owner" is always an admin. Create the account FIRST, then add its username here and restart;
# a listed name that has no account yet is blocked from sign-up so nobody else can take it.
ADMIN_USERNAMES=

# ---------- web / HTTPS ----------
# Host port for the app; pick one your other app does not use.
APP_PORT=8090
# 127.0.0.1 = only your reverse proxy can reach it (recommended). Never expose it directly.
APP_BIND=127.0.0.1
# true = the sign-in cookie only travels over HTTPS (keep true in production).
COOKIE_SECURE=true
# Leave false when your reverse proxy sends HSTS (see DEPLOY.md); true makes the app send it.
HSTS=false
# Which proxy may set X-Forwarded-For. Default: private/Docker networks. If nginx/Caddy runs on
# the host and connects via the Docker gateway, the default works. Use 1 for "exactly one proxy".
TRUST_PROXY=loopback, linklocal, uniquelocal

# ---------- limits & backups ----------
# Receipt storage per account, in MB.
RECEIPT_QUOTA_MB=200
# Daily database backups in ./backups are kept this many days.
BACKUP_KEEP_DAYS=14

# ---------- logs & app versions ----------
# Server log detail (JSON lines, see `docker compose logs app`): info (default), warn, error, debug.
LOG_LEVEL=info
# Android app (later phases): installed apps below this versionCode must update first. 0 = no minimum.
MIN_NATIVE_VERSION_CODE=0
# Admin activity log entries older than this many days are deleted automatically.
AUDIT_KEEP_DAYS=365
