# Copy to .env on the VPS and change the values:  cp .env.example .env

# Accounts: people create their own on the sign-in screen ("Create account").
# Set to false once everyone who should use the app has an account.
ALLOW_SIGNUP=true

# Optional built-in account (username "owner"). Leave empty to use only sign-up.
# At least 8 characters. Changing it later signs that account out everywhere.
APP_PASSWORD=

# Database password (only used inside Docker; make it long and random).
POSTGRES_PASSWORD=change-me-too
POSTGRES_DB=budget_me
POSTGRES_USER=budget_me

# Host port for the app. Pick one your other app does not use.
APP_PORT=8090
# 127.0.0.1 = only reachable through your reverse proxy (recommended).
# 0.0.0.0   = reachable directly on http://<vps-ip>:APP_PORT
APP_BIND=127.0.0.1
