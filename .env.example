# Budget me: production settings. Copy to .env on the VPS and fill in:
#   cp .env.example .env && chmod 600 .env && nano .env
# Generate strong random values with:  openssl rand -base64 32

# ---------- database (only used inside Docker) ----------
# REQUIRED, at least 16 characters. The app refuses to start with "change-me".
POSTGRES_PASSWORD=change-me-run-openssl-rand-base64-32
POSTGRES_DB=budget_me
POSTGRES_USER=budget_me

# ---------- accounts ----------
# People create their own accounts on the sign-in screen.
# Anyone who can open the app can create an account (there is no invite code). Set false to close
# sign-ups once everyone has an account; admins can also open/close them in the app.
ALLOW_SIGNUP=true
# Optional built-in account with username "owner" (at least 10 characters). Usually leave empty.
APP_PASSWORD=
# Accounts that can open the Admin page (users, sign-ups, password reset codes), comma separated.
# "owner" is always an admin. Create the account FIRST, then add its username here and restart;
# a listed name that has no account yet is blocked from sign-up so nobody else can take it.
ADMIN_USERNAMES=
# Recommended instead (2.3.0): the ONE admin account, by the email on that account. When set, "owner" and
# ADMIN_USERNAMES give no admin rights, nobody else can sign up with or switch to this email, and the admin
# area needs two-step sign-in plus the password and a code each time it is opened (15 minutes).
ADMIN_EMAIL=

# ---------- email ("Forgot password?" codes) ----------
# Default: the built-in "mail" service (Postfix in docker-compose) sends from no-reply@masrofy.online.
# It needs DNS records (SPF, DKIM, DMARC) and reverse DNS for the VPS; see DEPLOY.md, "Email".
# Leave these empty to use it. SMTP_HOST=off turns email off (admins can still make reset codes).
# Another SMTP server instead (e.g. Brevo's free plan): set all four, plus SMTP_REQUIRE_TLS=true.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_REQUIRE_TLS=
# The domain and hostname the built-in mail service sends as (must match your DNS).
MAIL_DOMAIN=masrofy.online
MAIL_HOSTNAME=mail.masrofy.online
# Sender shown in the email. Default: Masrofy <no-reply@masrofy.online>
MAIL_FROM=

# ---------- operations (optional; see DEPLOY.md, "Operations") ----------
# Encrypted off-site backups (deploy/backup-offsite.sh): any rclone remote + an age PUBLIC key.
OFFSITE_REMOTE=
OFFSITE_AGE_RECIPIENT=
OFFSITE_KEEP_DAYS=90
# Alerts from deploy/check-health.sh, restore test and backups (all free; set any):
# ntfy.sh topic (install the ntfy app and subscribe to the same long, random topic name)
ALERT_NTFY_TOPIC=
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=
DISK_ALERT_PERCENT=85

# Shown in Settings → Contact us (bug reports and ideas). Empty = the app's default address.
CONTACT_EMAIL=

# ---------- web / HTTPS ----------
# Host port for the app; pick one your other app does not use.
APP_PORT=8090
# 127.0.0.1 = only your reverse proxy can reach it (recommended). Never expose it directly.
APP_BIND=127.0.0.1
# true = the sign-in cookie only travels over HTTPS (keep true in production).
COOKIE_SECURE=true
# Leave false when your reverse proxy sends HSTS (see DEPLOY.md); true makes the app send it.
HSTS=false
# Which proxy may set X-Forwarded-For. Default: private/Docker networks. If nginx/Caddy runs on
# the host and connects via the Docker gateway, the default works. Use 1 for "exactly one proxy".
TRUST_PROXY=loopback, linklocal, uniquelocal

# ---------- limits & backups ----------
# Receipt storage per account, in MB.
RECEIPT_QUOTA_MB=200
# Daily database backups in ./backups are kept this many days.
BACKUP_KEEP_DAYS=14

# ---------- logs & app versions ----------
# Server log detail (JSON lines, see `docker compose logs app`): info (default), warn, error, debug.
LOG_LEVEL=info
# Android app (later phases): installed apps below this versionCode must update first. 0 = no minimum.
MIN_NATIVE_VERSION_CODE=0
# true (default): only the Android app can use Budget me; a browser sees a "Get the app" page with the
# download link. false: it also works as a website (any phone or computer browser).
APP_ONLY=true
# Admin activity log entries older than this many days are deleted automatically.
AUDIT_KEEP_DAYS=365
